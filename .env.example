# ── LLM Provider ──────────────────────────────────────────────────────────────
# "groq" = cloud API (free tier) | "ollama" = fully local
LLM_PROVIDER=groq

# Groq (https://console.groq.com) — required when LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (https://ollama.com) — required when LLM_PROVIDER=ollama
# Install Ollama, then: ollama pull qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Embeddings for semantic search (optional but recommended with Ollama)
# Run: ollama pull nomic-embed-text
EMBED_MODEL=nomic-embed-text

# ── Generation ────────────────────────────────────────────────────────────────
MAX_TOKENS=4096
MAX_HISTORY_CHARS=25000

# ── App ───────────────────────────────────────────────────────────────────────
PORT=5000
